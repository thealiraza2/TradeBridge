# MT5 demo account (used in Phase 4) — fill in from PRE_FLIGHT.md
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# Webhook secret — must be IDENTICAL in .env and in the TradingView alert
WEBHOOK_SECRET=your_generated_secret_from_phase_0

# Trading defaults
DEFAULT_RISK_PCT=1.0
DEFAULT_MAX_LOT=2.0
MAX_POSITIONS=5
MAX_DAILY_LOSS_PCT=3.0
MODE=demo
